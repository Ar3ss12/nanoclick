{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoClick",
  "version": "1.0.0-beta",
  "identifier": "com.nanoclick.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NanoClick",
        "width": 900,
        "height": 760,
        "minWidth": 860,
        "minHeight": 670,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "NanoClick Overlay",
        "url": "overlay.html",
        "transparent": true,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "hud",
        "title": "NanoClick HUD",
        "url": "hud.html",
        "transparent": true,
        "width": 140,
        "height": 40,
        "alwaysOnTop": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NanoClick Project",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCOEYwMUYwNDE0REQwQzkKUldUSjBFMUI4QUdQSzRMOFRONUhLbmZhdHJoMVIwY28rRTNiYTZjSEcyT2QvaHcwVExETmc4c0YK",
      "endpoints": [
        "https://github.com/Ar3ss12/nanoclick/releases/latest/download/latest.json"
      ]
    }
  }
}
