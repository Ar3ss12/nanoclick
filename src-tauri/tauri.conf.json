{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NanoClick",
  "version": "1.0.0",
  "identifier": "com.nanoclick.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NanoClick v3.0",
        "width": 900,
        "height": 590,
        "minWidth": 860,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "NanoClick Project",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMDdGNkE1NzlFRkQ5RUUKUldUdTJlOTVwZllIczZrZFpINFlSdXhRMkNUd2YzWGtTNTZJczBYWXFNSzRqOW16SlIzdytCS2sK",
      "endpoints": [
        "https://github.com/Ar3ss12/nanoclick/releases/latest/download/latest.json"
      ]
    }
  }
}